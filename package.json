{
  "name": "meal-ai-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo: Express API + React web app",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @meal/api\" \"npm run dev -w @meal/web\"",
    "dev:api": "npm run dev -w @meal/api",
    "dev:web": "npm run dev -w @meal/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "migration:generate": "npm run migration:generate -w @meal/api",
    "migration:run": "npm run migration:run -w @meal/api",
    "migration:revert": "npm run migration:revert -w @meal/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
