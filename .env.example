# Copy to .env and fill in real values.

# --- API ---
API_PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
API_BIND_HOST=127.0.0.1

# --- Web ---
WEB_PORT=5173
WEB_CONTAINER_PORT=80
VITE_API_BASE_URL=/api
API_HOST=api

# --- Postgres (TypeORM) ---
DB_HOST=db
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=meal_ai_agent
POSTGRES_IMAGE=postgres:16-alpine

DB_SYNCHRONIZE=false
DB_LOGGING=false

# --- Auth (JWT secrets) ---
ACCESS_SECRET=change-me
REFRESH_SECRET=change-me

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX=20
GLOBAL_RATE_LIMIT_MAX=300

# --- Docker infra ---
RESTART_POLICY=unless-stopped
DB_HEALTH_INTERVAL=5s
DB_HEALTH_TIMEOUT=3s
DB_HEALTH_RETRIES=5
API_HEALTH_INTERVAL=10s
API_HEALTH_TIMEOUT=3s
API_HEALTH_START_PERIOD=15s
API_HEALTH_RETRIES=5
