# Copy to .env and fill in real values.

# --- API ---
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Web ---
WEB_PORT=5173
VITE_API_BASE_URL=/api

# --- Postgres (TypeORM) ---
DB_HOST=localhost
