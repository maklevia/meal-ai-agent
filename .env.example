# Copy to .env and fill in real values.

# --- API ---
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Web ---
WEB_PORT=5173
VITE_API_BASE_URL=/api

# --- Postgres (TypeORM) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=meal_ai_agent

DB_SYNCHRONIZE=false

DB_LOGGING=false

# --- Auth (JWT secrets) ---
ACCESS_SECRET=change-me
REFRESH_SECRET=change-me

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
# Max failed auth attempts per IP per 15 min (successful logins don't count)
AUTH_RATE_LIMIT_MAX=20
# Max requests per IP per 10 min for all other endpoints
GLOBAL_RATE_LIMIT_MAX=300
