{
  "name": "@meal/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "migration:generate": "DOTENV_CONFIG_PATH=../../.env tsx -r tsconfig-paths/register ../../node_modules/typeorm/cli.js migration:generate -d src/db/data-source.ts",
    "migration:run": "DOTENV_CONFIG_PATH=../../.env tsx -r tsconfig-paths/register ../../node_modules/typeorm/cli.js migration:run -d src/db/data-source.ts",
    "migration:revert": "DOTENV_CONFIG_PATH=../../.env tsx -r tsconfig-paths/register ../../node_modules/typeorm/cli.js migration:revert -d src/db/data-source.ts"
  },
  "dependencies": {
    "bcrypt-ts": "^9.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "typeorm-naming-strategies": "^4.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsc-alias": "^1.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
